# Copy to data/credentials/.env and fill in your values.
# NO Anthropic/OpenAI API key is needed: the AI reasoning runs through YOUR
# local agent CLI subscription (Claude Code in v1).

# ═══ WHERE YOU'RE LOOKING FOR WORK ═══════════════════════════════════════════
# Three settings, and every default is neutral — nobody inherits someone else's
# market. Two of them say where to SEARCH (per source, since each site wants a
# different format); the third says which results you can actually take.
#
# ── 1. Indeed: where to search. It requires a country (it has no "global"
# value). JOB_SEARCH_COUNTRY is an ISO 3166 two-letter code; JOB_SEARCH_LOCATION
# is a city/state string or the literal "remote".
JOB_SEARCH_COUNTRY=US
JOB_SEARCH_LOCATION=remote

# Indeed listings carry no job description; fetching one costs an extra call per
# posting (~11s each) inside the same agent turn. Descriptions matter a lot for
# scoring, so this is on by default — lower the cap or turn it off if searches
# feel too slow.
INDEED_FETCH_DESCRIPTIONS=true
INDEED_MAX_DETAILS=25

# ── 2. LinkedIn: where to search (public guest endpoint — no login, no key).
# LinkedIn wants a geography NAME, not a country code. "Worldwide" is its own
# neutral value; set yours (e.g. Argentina, Spain, "New York, United States").
LINKEDIN_LOCATION=Worldwide
# The guest endpoint rate-limits (429) after ~10 pages per IP, and each page
# costs a 3-6s delay. Raise carefully.
LINKEDIN_MAX_PAGES=3
# Search cards carry no description; fetching one is a second request per
# posting, cached by job id under data/cache/ so re-runs are nearly free.
LINKEDIN_FETCH_DESCRIPTIONS=true

# ── 3. Which results you can actually take. Every source returns roles that are
# locked to a region — "US only", "EMEA", "Remote (India)". This drops the ones
# incompatible with yours, keeping anything advertised as global/anywhere.
# One of: worldwide | latam | north-america | europe | apac
# "worldwide" (the default) filters nothing — start there and narrow it if your
# results are full of roles you can't legally take. Region term lists live in
# core/location_filters.py; add a region there if yours isn't covered.
TARGET_REGION=worldwide

# ── Optional: Indeed via Scrappa (fallback when the Indeed MCP connector is unavailable)
# The `indeed` source prefers the MCP connector, which needs no key but must be
# authorized once interactively (`/mcp` in your agent CLI) because the backend
# runs headless and cannot complete OAuth. Without it that source is skipped.
SCRAPPA_API_KEY=

# ── Optional: Google Sheets/Drive mirror (OAuth)
# Place your Google OAuth credentials.json in data/credentials/
# token.json / token_drive.json are auto-generated on first auth.
GOOGLE_CREDENTIALS_PATH=data/credentials/credentials.json
SPREADSHEET_ID=
